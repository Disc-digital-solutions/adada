# Copy this file to .env.local and fill in the values. .env.local is never put in git.

# The public address of the site, used in shared links and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3240

# From the Supabase project: Project Settings → API.
# These two are meant to be public. NEVER put the "service role" key in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
