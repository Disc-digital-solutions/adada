# Copy this file to .env.local and fill in the values. .env.local is never put in git.

# The public address of the site, used in shared links and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3240

# The team's WhatsApp line, with country code (+90533...). A business number, never a private one:
# it is shown to every visitor. While the database is not connected, the "Post" form sends new ads
# here for the team to publish by hand, and "Report this ad" sends reports here. Leave empty to turn both off.
NEXT_PUBLIC_TEAM_WHATSAPP=

# From the Supabase project: Project Settings → API.
# These two are meant to be public. NEVER put the "service role" key in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
